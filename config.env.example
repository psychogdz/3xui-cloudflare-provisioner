# ============================================================================
# 3xui-cloudflare-provisioner Configuration Template
# ============================================================================
# Copy this file to config.env or pass variables via command-line arguments.
#
# Usage with flags:
#   sudo ./install.sh --domain example.com --cf-token <token>
#
# Usage with environment file:
#   cp config.env.example config.env
#   sudo ./install.sh --config config.env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Cloudflare & Domain Settings (Required for CDN & Auto-SSL)
# ----------------------------------------------------------------------------
# Your root domain registered in Cloudflare (e.g. example.com)
DOMAIN="example.com"

# Subdomain prefix to create/use (e.g. vpn -> vpn.example.com).
# Leave empty to generate a random 4-character prefix (e.g. node-7f2a.example.com).
SUBDOMAIN=""

# Cloudflare API Token with Zone:DNS:Edit permissions
# Get one at: https://dash.cloudflare.com/profile/api-tokens
CF_TOKEN="your_cloudflare_api_token_here"

# Optional: Cloudflare Zone ID (if left blank, automatically queried via API)
CF_ZONE_ID=""

# ----------------------------------------------------------------------------
# 2. 3X-UI Panel Customization
# ----------------------------------------------------------------------------
# Leave these blank to automatically generate secure, random values on install:
PANEL_USERNAME=""
PANEL_PASSWORD=""
PANEL_PORT="2053"
PANEL_BASE_PATH=""

# ----------------------------------------------------------------------------
# 3. Client & Subscription Settings
# ----------------------------------------------------------------------------
# Client identifier email (auto-generated if empty)
CLIENT_EMAIL=""

# Port for subscription service (default: 2096)
SUB_PORT="2096"

# ----------------------------------------------------------------------------
# 4. Inbound Protocols
# ----------------------------------------------------------------------------
# Primary CDN Inbound (VLESS + WebSocket + TLS over Cloudflare)
INBOUND_CDN_PORT="443"
INBOUND_CDN_PATH="/ws"

# gRPC CDN Inbound (VLESS + gRPC + TLS over Cloudflare)
INBOUND_GRPC_PORT="8443"
INBOUND_GRPC_SERVICE="grpc-service"

# Fallback Reality Inbound (Direct VLESS Reality Vision)
INBOUND_REALITY_PORT="2083"
REALITY_DEST="www.samsung.com:443"
REALITY_SERVER_NAMES="www.samsung.com"

# ----------------------------------------------------------------------------
# 5. Advanced Flags
# ----------------------------------------------------------------------------
# Enable BBR TCP congestion control optimization (true/false)
ENABLE_BBR="true"

# Automated non-interactive mode (true/false)
NON_INTERACTIVE="false"
